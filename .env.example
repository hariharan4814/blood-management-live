# ==============================================================================
# Django Configuration (.env.example)
# Copy this file to .env for local development or set variables in Render Dashboard.
# NEVER commit real passwords or production credentials to version control.
# ==============================================================================

# Django Secret Key (Generate a random secret key for production)
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production

# Debug Mode (True for local development, False for production)
DEBUG=True

# Database Configuration
# Leave unset or empty for local SQLite (db.sqlite3)
# In production, set to your Neon PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/blood_mgmt?sslmode=require
DATABASE_URL=

# Allowed Hosts (comma-separated hostnames or domains)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins (comma-separated URLs for frontend access)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:5173,http://127.0.0.1:3000

# CSRF Trusted Origins (comma-separated origins with scheme)
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:5173,http://127.0.0.1:3000

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-blood-mgmt-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Blood Management System <your-blood-mgmt-email@gmail.com>
